# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Secao 11 da spec: chaves de API do PSP nunca vao para o repositorio.
.env
.env.*
# O .env.example e a excecao: documenta quais variaveis existem, sem valores.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
