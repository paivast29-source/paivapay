# =============================================================================
# PaivaPay - variaveis de ambiente
# Copie este arquivo para .env e preencha. O .env NUNCA vai para o repositorio.
# Secao 11 da especificacao: chaves de API do PSP so em variavel de ambiente.
# =============================================================================

# Banco de dados (docker compose up -d)
DATABASE_URL="postgresql://paivapay:paivapay_local@localhost:5433/paivapay?schema=public"

# Segredo usado para assinar os cookies de sessao.
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-no-minimo-32-caracteres"

# URL publica da aplicacao. Usada para montar o link de pagamento enviado ao cliente.
# Producao: https://pay.paivast.com.br
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Provedor de pagamentos (PSP)
# -----------------------------------------------------------------------------
# mock  = provider local de desenvolvimento, gera Pix/boleto ficticios.
#         Nenhuma chamada de rede, nenhum dinheiro real. Use enquanto nao houver
#         conta no Asaas.
# asaas = integracao real. Exige ASAAS_API_KEY e ASAAS_WEBHOOK_TOKEN.
PSP_PROVIDER="mock"

# Libera PSP_PROVIDER=mock em ambiente publicado (NODE_ENV=production).
# Use APENAS para uma vitrine de demonstracao, enquanto a conta no PSP nao
# existe. Com esta variavel ligada, toda tela exibe uma faixa avisando que
# nenhuma cobranca ali e real.
#
# Deixe vazia em producao de verdade: sem ela, um deploy que esqueca de
# configurar o Asaas falha na hora, em vez de emitir cobrancas que nunca caem
# na conta.
PERMITIR_PSP_MOCK=""

# Asaas - preencher apenas quando a conta estiver aprovada (Fase 0 da spec).
# ASAAS_API_BASE="https://api-sandbox.asaas.com/v3"   # sandbox
# ASAAS_API_BASE="https://api.asaas.com/v3"           # producao
ASAAS_API_BASE="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""

# Token de autenticacao do webhook, configurado no painel do Asaas.
# O Asaas envia esse valor no header `asaas-access-token` em toda notificacao.
# Requisicao sem este token e descartada (secao 10, regra 2).
ASAAS_WEBHOOK_TOKEN=""

# -----------------------------------------------------------------------------
# Rotinas automaticas
# -----------------------------------------------------------------------------
# Protege GET /api/rotinas/reconciliacao (secao 10, regra 4).
# A Vercel envia este valor no header `authorization: Bearer <...>` ao disparar
# o cron definido em vercel.json. Sem esta variavel a rota recusa tudo.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Conta recebedora padrao (secao 4.3)
# -----------------------------------------------------------------------------
# Na v1 todas as cobrancas apontam para esta conta: a da Paiva Studio.
CONTA_RECEBEDORA_NOME="Paiva Studio"

# -----------------------------------------------------------------------------
# Seed do primeiro usuario diretor (apenas desenvolvimento)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="umberto@paivast.com.br"
SEED_ADMIN_SENHA="mudar123"
SEED_ADMIN_NOME="Umberto Paiva"
